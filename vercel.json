{
  "buildCommand": "cd frontend && vite build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/backend/api/auth.js"
    },
    {
      "source": "/api/applicants/:id",
      "destination": "/backend/api/applicants/[id].js"
    },
    {
      "source": "/api/applicants",
      "destination": "/backend/api/applicants.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
