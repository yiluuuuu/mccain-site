{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    },
    {
      "src": "backend/api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/auth/login",
      "dest": "/backend/api/auth.js"
    },
    {
      "src": "/api/applicants/([^/]+)",
      "dest": "/backend/api/applicants/[id].js?id=$1"
    },
    {
      "src": "/api/applicants",
      "dest": "/backend/api/applicants.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
